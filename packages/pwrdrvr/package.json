{
  "name": "pwrdrvr",
  "version": "0.0.0",
  "description": "Publish tool for deploying apps and updates",
  "main": "dist/index.js",
  "source": "src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "pwrdrvr": "./bin/run"
  },
  "engineStrict": true,
  "scripts": {
    "test": "pnpm --dir ../.. test packages/pwrdrvr --runInBand"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "!dist/lib/deployer-types.d.ts",
    "!dist/lib/deployer-types.d.ts.map",
    "!dist/lib/deployer-types.js",
    "!dist/lib/deployer-types.js.map",
    "!src/commands/*.spec.ts",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pwrdrvr/microapps-core.git"
  },
  "author": "PwrDrvr LLC",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pwrdrvr/microapps-core/issues"
  },
  "homepage": "https://github.com/pwrdrvr/microapps-core#readme",
  "dependencies": {
    "@aws-sdk/abort-controller": "^3.374.0",
    "@aws-sdk/client-lambda": "^3.1139.0",
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/client-sts": "^3.1139.0",
    "@aws-sdk/credential-provider-node": "^3.972.84",
    "@aws-sdk/lib-storage": "^3.1139.0",
    "@oclif/core": "^5.1.8",
    "@oclif/plugin-help": "^7.0.4",
    "@oclif/plugin-version": "^3.0.5",
    "@shutterstock/p-map-iterable": "^1.2.0",
    "chalk": "^6.0.1",
    "convict": "^6.2.5",
    "fs-extra": "^11.4.1",
    "js-yaml": "^5.4.3",
    "listr2": "^11.2.0",
    "mime-types": "^3.0.2",
    "reflect-metadata": "^0.2.2",
    "source-map-support": "0.5.21",
    "ts-convict": "^1.1.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@aws-sdk/abort-controller": "3.374.0",
    "@aws-sdk/client-lambda": "3.1139.0",
    "@aws-sdk/client-s3": "3.1139.0",
    "@aws-sdk/client-sts": "3.1139.0",
    "@aws-sdk/credential-provider-node": "3.972.84",
    "@aws-sdk/lib-storage": "3.1139.0",
    "@types/convict": "^6.1.6",
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/mime-types": "^3.0.1",
    "@types/source-map-support": "0.5.10",
    "type-fest": "^5.10.0"
  },
  "oclif": {
    "commands": "./dist/commands/",
    "bin": "pwrdrvr",
    "topicSeparator": ":",
    "additionalHelpFlags": [
      "-h"
    ],
    "additionalVersionFlags": [
      "-v"
    ],
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-version"
    ]
  },
  "engines": {
    "node": ">= 24.0.0"
  }
}
